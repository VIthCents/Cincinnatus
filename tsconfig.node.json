{
  // Everything that runs under Node: the CLI harness, the tests, and Vite's
  // own config. Node globals are available here and nowhere else in src/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["scripts", "tests", "src/core", "vite.config.ts"]
}
