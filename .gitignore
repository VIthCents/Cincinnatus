# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Cincinnatus ---

# Local database + anything you point --db at. NEVER commit: this can hold a real resume.
.data/

# API keys. The harness reads USAJOBS_API_KEY / USAJOBS_USER_AGENT from here.
.env
.env.*
!.env.example

# TypeScript project-reference build info
.tsbuild/
*.tsbuildinfo

# Local embedding model cache (~23 MB). Kept out of node_modules so pnpm
# reinstalls do not force a re-download.
.models/

# ONNX wasm runtime, copied from node_modules by scripts/copy-wasm.ts.
public/wasm/

# Test + coverage output
coverage/

# Full-run HTTP recordings from `pnpm harness --capture`, used by --offline.
# Local only: a whole-watchlist capture is tens of megabytes. The small,
# hand-checked fixtures the test suite runs against are committed under
# fixtures/greenhouse and fixtures/usajobs instead.
fixtures/http/


# Local Windows signing scaffolding. The dlib is a 14 MB NuGet download and the
# metadata/config name one machine's paths — CI writes its own (release.yml).
tools/
signing-metadata.json
tauri.localsign.conf.json
