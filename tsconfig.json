{
  // Editor-facing config: broad, so IDEs resolve every file in the repo.
  //
  // Typechecking in CI does NOT use this file. It runs the three narrow configs
  // below, in sequence, because the whole point is that they disagree about what
  // globals exist:
  //
  //   tsconfig.core.json  src/core  — no DOM, no Node. This is what keeps the
  //                                   agent core runnable in both Node and the
  //                                   webview (SPEC constraint 7).
  //   tsconfig.ui.json    src/ui    — DOM, React.
  //   tsconfig.node.json  scripts, tests, vite.config.ts — Node.
  //
  // Deliberately NOT using project references / composite. Overlapping
  // `include` globs across composite projects produce TS6059/TS6307 errors that
  // are tedious to unpick, and we get no build-output benefit since every config
  // is noEmit.
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src", "scripts", "tests", "vite.config.ts", "eslint.config.js"]
}
