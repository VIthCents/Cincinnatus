# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Only the CLI harness reads these. The packaged app stores keys in the OS
# keychain instead (Phase 4); they are never written to SQLite.

# USAJobs (optional, free). Unlocks federal jobs with veterans preference.
# Register at https://developer.usajobs.gov/apirequest/
#
# USAJOBS_USER_AGENT must be the email address you registered with. USAJobs
# rejects requests whose User-Agent does not match the key's registered email,
# so both values have to be right, not just the key.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Anthropic (optional). The job search works without it. Needed for the AI
# commands: analyze, parse-resume, revise, tailor, coverletter.
# This is the Claude *developer console* (prepaid credits), not a claude.ai
# Pro/Max chat subscription: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Adzuna — optional, free. Unlocks driving, warehouse and trades jobs that the
# employer boards do not carry. Sign up at https://developer.adzuna.com/signup
# and choose "Publishing Adzuna ad listings" as what you are building.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
