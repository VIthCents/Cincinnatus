{
  // Webview code. DOM is available here; Node is not.
  // src/core is included because the UI imports from it, but core is
  // independently checked by tsconfig.core.json under stricter libs.
  // vite/client types cover asset imports like "...?url".
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src/ui", "src/core", "src/tauri", "src/shared"]
}
