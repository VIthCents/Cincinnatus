# Normalize line endings. Without this, developing on Windows with core.autocrlf=true
# and running `prettier --check` (endOfLine: "lf") on Linux CI fails on every file.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.onnx binary
*.woff binary
*.woff2 binary

# Fixtures are byte-compared in tests; pin them to LF explicitly so a hash
# computed over file bytes does not diverge between Windows and CI.
fixtures/**/*.json text eol=lf
data/**/*.json text eol=lf
